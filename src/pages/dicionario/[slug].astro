---
import Base from '../../layouts/Base.astro'; import Badges from '../../components/Badges.astro'; import CodeBlock from '../../components/CodeBlock.astro'; import Diagram from '../../components/Diagram.astro'; import {entries} from '../../data/entries';
export function getStaticPaths(){return entries.map((entry,index)=>({params:{slug:entry.slug},props:{entry,index}}))} const {entry,index}=Astro.props; const previous=entries[index-1];const next=entries[index+1]; const jsonLd={"@context":"https://schema.org","@type":"DefinedTerm","name":entry.title,"description":entry.shortDefinition,"inDefinedTermSet":"CSS Visual"};
---
<Base title={`${entry.title} — guia visual | CSS Visual`} description={entry.shortDefinition}><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/><div class="container breadcrumbs"><a href="/">Início</a> / <a href="/dicionario">Dicionário</a> / <span>{entry.title}</span></div><article class="container"><header class="entry-hero"><Badges category={entry.category} difficulty={entry.difficulty} type={entry.type}/><h1>{entry.title}</h1><p class="lede">{entry.shortDefinition}</p><p><strong>Para que serve:</strong> {entry.utility}</p></header><div class="entry-content"><section class="entry-section wide"><h2>Entenda o conceito</h2><p>{entry.masterExplanation}</p></section><CodeBlock label="Sintaxe essencial" code={entry.syntax}/><Diagram kind={entry.slug} description={entry.visualDescription}/><CodeBlock label="HTML do exemplo" code={entry.htmlExample}/><CodeBlock label="CSS do exemplo" code={entry.cssExample}/><section class="entry-section wide"><h2>Resultado visual esperado</h2><p>{entry.visualDescription}</p><p class="callout panel">A demonstração usa o mesmo mecanismo do código acima. Redimensione a página para observar seu comportamento responsivo.</p></section><section class="entry-section"><h2>Passo a passo</h2><ol>{entry.stepByStep.map((x:string)=><li>{x}</li>)}</ol></section><section class="entry-section"><h2>Decida quando usar</h2><h3>Use quando</h3><ul>{entry.whenToUse.map((x:string)=><li>{x}</li>)}</ul><h3>Evite quando</h3><ul>{entry.whenToAvoid.map((x:string)=><li>{x}</li>)}</ul></section><section class="entry-section"><h2>Erro comum</h2><p>{entry.commonMistake}</p><h3>Como corrigir</h3><p>{entry.solution}</p></section><section class="entry-section"><h2>Dica profissional</h2><p>{entry.professionalTip}</p></section><section class="entry-section"><h2>Acessibilidade e performance</h2><h3>Acessibilidade</h3><p>{entry.accessibilityNote}</p><h3>Performance</h3><p>{entry.performanceNote}</p></section><section class="entry-section"><h2>Limitações relevantes</h2><ul>{entry.limitations.map((x:string)=><li>{x}</li>)}</ul></section><section class="entry-section wide"><h2>Conceitos relacionados</h2><div class="badges">{entry.relatedTerms.map((term:string)=>{const related=entries.find(e=>e.title===term);return related?<a href={`/dicionario/${related.slug}`}>{term}</a>:<span>{term}</span>})}</div><h2>Em uma frase</h2><p class="lede">{entry.finalSummary}</p></section></div><nav class="prev-next" aria-label="Verbetes adjacentes"><span>{previous&&<a href={`/dicionario/${previous.slug}`}>← {previous.title}</a>}</span><span>{next&&<a href={`/dicionario/${next.slug}`}>{next.title} →</a>}</span></nav></article></Base>
