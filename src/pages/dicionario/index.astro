---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import {entries} from '../../data/entries';
const categories=['Cascata e especificidade','Layout','Dimensionamento','Responsividade','Posicionamento e camadas','Movimento e animação','Efeitos visuais','Performance','Arquitetura de CSS']; const difficulties=['Intermediário','Avançado','Especialista']; const types=['Conceito','Propriedade','Função','Regra','Técnica'];
---
<Base title="Dicionário de CSS avançado | CSS Visual" description="Pesquise e filtre conceitos avançados de CSS explicados com exemplos e diagramas."><section class="container section"><p class="eyebrow">5 verbetes para aprender em profundidade</p><h1>Dicionário visual de CSS</h1><p class="lede">Busque sem acentos, combine filtros e encontre o mecanismo certo para seu problema.</p><div class="search"><label for="catalog-search">Buscar termos</label><div><input id="catalog-search" type="search" placeholder="Título, categoria, palavra-chave…"><button type="button" id="clear-search">Limpar</button></div></div><div class="catalog-layout"><aside><details class="panel filters" open><summary><strong>Filtros</strong></summary><label for="category">Categoria</label><select id="category"><option value="">Todas</option>{categories.map(v=><option>{v}</option>)}</select><label for="difficulty">Dificuldade</label><select id="difficulty"><option value="">Todas</option>{difficulties.map(v=><option>{v}</option>)}</select><label for="type">Tipo</label><select id="type"><option value="">Todos</option>{types.map(v=><option>{v}</option>)}</select><button type="button" id="clear-filters">Limpar filtros</button></details></aside><section><div class="results-head"><h2>Resultados</h2><p id="count" aria-live="polite">{entries.length} resultados</p></div><div class="grid" id="cards">{entries.map(entry=><Card entry={entry}/>)}</div><div id="empty" class="empty" hidden><h2>Nenhum termo encontrado</h2><p>Tente “grid”, “camadas” ou remova algum filtro.</p><button type="button" data-clear-all>Limpar busca e filtros</button></div></section></div></section><script src="../../scripts/catalog.ts"></script></Base>
