---
import Base from '../layouts/Base.astro'; import SearchBox from '../components/SearchBox.astro'; import Card from '../components/Card.astro'; import {entries} from '../data/entries';
const categories=[...new Set(entries.map(e=>e.category))];
---
<Base title="CSS Visual — CSS avançado explicado visualmente" description="Dicionário visual de CSS avançado com código, exemplos e diagramas em português."><section class="hero container"><p class="eyebrow">Dicionário técnico · visual · direto</p><h1>Entenda CSS avançado por meio de código, exemplos e diagramas visuais.</h1><p class="lede">Do “por que meu z-index não funciona?” até arquiteturas de cascata: aprenda o mecanismo, veja-o em ação e use com confiança.</p><SearchBox/><a href="/dicionario">Ou explore todo o dicionário →</a></section><section class="section container"><div class="section-head"><div><p class="eyebrow">Comece pelo problema</p><h2>Categorias</h2></div></div><div class="badges">{categories.map(c=><a class="button" href={`/dicionario?categoria=${encodeURIComponent(c)}`}>{c}</a>)}</div></section><section class="section container"><div class="section-head"><div><p class="eyebrow">Seleção do MVP</p><h2>Termos em destaque</h2></div><a href="/dicionario">Ver os 5 termos</a></div><div class="grid">{entries.slice(0,3).map(entry=><Card entry={entry}/>)}</div></section><section class="section container"><p class="eyebrow">Como ensinamos</p><h2>Da ideia abstrata à decisão prática</h2><div class="grid method"><article class="panel"><h3>Entenda</h3><p>Uma definição rápida e uma explicação mestre constroem o modelo mental.</p></article><article class="panel"><h3>Visualize</h3><p>Código, resultado e diagrama tornam relações invisíveis concretas.</p></article><article class="panel"><h3>Aplique</h3><p>Erros, correções, acessibilidade e performance apoiam decisões reais.</p></article></div></section><section class="section narrow panel"><h2>Pronto para enxergar a lógica por trás do CSS?</h2><p>Explore o catálogo, filtre por assunto e conecte conceitos relacionados.</p><a class="button" href="/dicionario">Explorar o dicionário</a></section></Base>
