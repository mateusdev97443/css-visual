---
const {kind,description}=Astro.props;
const labels:Record<string,string[]>={
 'stacking-context':['Contexto B · Header · z 2','Contexto A · Painel · z 1','Modal · z 9999 (preso em A)'],
 'css-grid':['Área: topo (colunas 1–3)','Menu · célula 1','Conteúdo · células 2–3','↔ gap'],
 'container-queries':['Contêiner estreito','Card: pilha','Contêiner largo','Card: imagem + texto'],
 clamp:['Mínimo','Valor fluido ↗','Máximo'],
 'cascade-layers':['↑ prioridade','overrides','utilities','components · especificidade interna','base']};
---
<figure class={`diagram diagram-${kind}`}><figcaption>Diagrama visual</figcaption><div class="diagram-stage" aria-hidden="true">{labels[kind].map((label:string,i:number)=><div class={`diagram-item item-${i}`}>{label}</div>)}</div><p class="diagram-description"><strong>Descrição equivalente:</strong> {description}</p></figure>
